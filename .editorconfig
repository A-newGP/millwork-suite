# SPDX-License-Identifier: CC0-1.0

# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab

# Language conventions: 4 spaces for Rust (rustfmt) and C# (.NET style).
[*.{rs,cs}]
indent_size = 4

# License texts are copied verbatim from their official sources.
[{LICENSE,LICENSES/**}]
trim_trailing_whitespace = false
insert_final_newline = unset
