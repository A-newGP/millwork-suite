# Normalize all text files to LF in the repository, regardless of the
# contributor's operating system or local Git settings.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# CAD and drawing fixtures are compared byte for byte; never touch them.
*.dxf  -text diff
*.dwg  binary
*.pdf  binary

# Images and fonts.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.svg  text eol=lf
