import { LineEdit, SpinBox, StandardTableView } from "std-widgets.slint";

// Shapes in millimeters, +y up, as produced by oc-ui-core.
export struct RectShape { x: float, y: float, w: float, h: float, kind: int }
export struct CircleShape { cx: float, cy: float, r: float }
export struct LineShape { x1: float, y1: float, x2: float, y2: float }
export struct LabelShape { x: float, y: float, text: string, vertical: bool }

component Field inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    callback edited();
    spacing: 4px;
    Text { text: root.label; }
    LineEdit {
        accessible-label: root.label;
        text <=> root.value;
        edited => { root.edited(); }
    }
}

export component AppWindow inherits Window {
    title: "OpenCabinet UI spike — Slint";
    preferred-width: 1100px;
    preferred-height: 720px;

    in property <[RectShape]> rects;
    in property <[CircleShape]> circles;
    in property <[LineShape]> lines;
    in property <[LabelShape]> labels;
    in property <float> min-x;
    in property <float> min-y;
    in property <float> max-x;
    in property <float> max-y;
    in property <[[StandardListViewItem]]> rows;
    in property <string> error;
    in-out property <string> width-text;
    in-out property <string> height-text;
    in-out property <string> depth-text;
    in-out property <int> doors;
    callback edited();

    HorizontalLayout {
        VerticalLayout {
            width: 240px;
            padding: 16px;
            spacing: 12px;
            alignment: start;
            Text { text: "Base cabinet"; font-size: 18px; font-weight: 700; }
            Field { label: "Width (in)"; value <=> root.width-text; edited => { root.edited(); } }
            Field { label: "Height (in)"; value <=> root.height-text; edited => { root.edited(); } }
            Field { label: "Depth (in)"; value <=> root.depth-text; edited => { root.edited(); } }
            Text { text: "Doors"; }
            SpinBox {
                minimum: 1;
                maximum: 2;
                value <=> root.doors;
                edited => { root.edited(); }
            }
            Text { text: root.error; color: #c62828; wrap: word-wrap; }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            canvas := Rectangle {
                background: white;
                clip: true;
                property <float> span-x: root.max-x - root.min-x;
                property <float> span-y: root.max-y - root.min-y;
                property <length> scale: min(self.width / self.span-x, self.height / self.span-y);
                property <length> offset-x: (self.width - self.span-x * self.scale) / 2;
                property <length> offset-y: (self.height - self.span-y * self.scale) / 2;

                for r in root.rects: Rectangle {
                    x: parent.offset-x + (r.x - root.min-x) * parent.scale;
                    y: parent.offset-y + (root.max-y - r.y - r.h) * parent.scale;
                    width: r.w * parent.scale;
                    height: r.h * parent.scale;
                    background: r.kind == 0 ? #e0e0e0 : r.kind == 2 ? #f3e3c3 : transparent;
                    border-color: #212121;
                    border-width: 1px;
                }
                for c in root.circles: Rectangle {
                    x: parent.offset-x + (c.cx - c.r - root.min-x) * parent.scale;
                    y: parent.offset-y + (root.max-y - c.cy - c.r) * parent.scale;
                    width: 2 * c.r * parent.scale;
                    height: self.width;
                    border-radius: self.width / 2;
                    border-color: #757575;
                    border-width: 1px;
                }
                // Dimension lines are axis-aligned, so thin rectangles draw them.
                for l in root.lines: Rectangle {
                    x: parent.offset-x + (min(l.x1, l.x2) - root.min-x) * parent.scale;
                    y: parent.offset-y + (root.max-y - max(l.y1, l.y2)) * parent.scale;
                    width: max(abs(l.x2 - l.x1) * parent.scale, 1px);
                    height: max(abs(l.y2 - l.y1) * parent.scale, 1px);
                    background: #1565c0;
                }
                for t in root.labels: Text {
                    // Anchored at the label's center, as defined by oc-ui-core.
                    x: parent.offset-x + (t.x - root.min-x) * parent.scale - self.width / 2;
                    y: parent.offset-y + (root.max-y - t.y) * parent.scale - self.height / 2;
                    text: t.text;
                    color: #1565c0;
                    font-size: 13px;
                    transform-rotation: t.vertical ? -90deg : 0deg;
                }
            }

            StandardTableView {
                height: 280px;
                columns: [
                    { title: "Part" }, { title: "Material" },
                    { title: "Qty" }, { title: "Length" },
                    { title: "Width" }, { title: "Thickness" },
                ];
                rows: root.rows;
            }
        }
    }
}
