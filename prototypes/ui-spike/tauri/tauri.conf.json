{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oc-ui-tauri",
  "version": "0.1.0",
  "identifier": "org.opencabinet.ui-spike",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenCabinet UI spike — Tauri",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
